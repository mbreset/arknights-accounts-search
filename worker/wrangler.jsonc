{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arknights-visitor-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mbreset.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arknights-visitor-stats",
      "database_id": "602d79c8-94cc-43be-a0b5-5df30dce32ea",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "VISIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
